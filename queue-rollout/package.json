{
  "name": "queue-rollout",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Wave-based config rollout/rollback controller for queue-processing services",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "controller": "npm run build --silent && node dist/src/server.js",
    "fixtures": "npm run build --silent && node dist/src/fixture.js",
    "ops": "npm run build --silent && node dist/src/cli.js",
    "test": "npm run build --silent && node --test --test-reporter=spec dist/test/e2e.test.js"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "typescript": "^5.7.0"
  }
}
